# ==========================================
# baggyHood Droplist Backend Configuration
# ==========================================

PORT=5050
NODE_ENV=development

# 1. Admin Recipient (HIDDEN FROM USERS)
ADMIN_EMAIL=udaychaudhary419@gmail.com

# 2. Primary Email: Nodemailer (SMTP / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_16_character_app_password

# 3. Fallback Email: Brevo (Sendinblue) HTTP API (Never blocked on Render)
# Sign up free at brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=alerts@baggyhood.com
BREVO_SENDER_NAME=baggyHood Drops

# 4. Optional: Instant Customer WhatsApp Welcome Confirmation
# Sign up at twilio.com for WhatsApp Sandbox or live WhatsApp sender
ENABLE_WHATSAPP_WELCOME=false
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
