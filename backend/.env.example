# ==========================================
# baggyHood Droplist Backend Configuration
# ==========================================

PORT=5050
NODE_ENV=development

# 1. Admin Recipient (HIDDEN FROM USERS)
ADMIN_EMAIL=udaychaudhary419@gmail.com

# 2. Resend HTTP API (Recommended — Highest Inbox Deliverability, Render-safe over port 443)
# Sign up free at resend.com -> API Keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=baggyHood <onboarding@resend.dev>

# 3. Brevo (Sendinblue) HTTP API (Render-safe over port 443)
# Sign up free at brevo.com -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=baggyHood <baggyhoodindia@gmail.com>
BREVO_SENDER_NAME=baggyHood Drops

# 4. Primary Nodemailer SMTP (Gmail App Password — for local dev or SMTP hosts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=baggyhoodindia@gmail.com
SMTP_PASS=your_16_character_app_password

# 4. Optional: Instant Customer WhatsApp Welcome Confirmation
# Sign up at twilio.com for WhatsApp Sandbox or live WhatsApp sender
ENABLE_WHATSAPP_WELCOME=false
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886
